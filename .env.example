# Copia este fichero a .env y rellena tus credenciales.
#
#   cp .env.example .env
#
# .env esta en .gitignore: las credenciales no entran nunca al repositorio.
# Comprueba que han quedado bien con:
#
#   convocatorias-mcp doctor --check-api

# --- Adzuna (fuente principal) -------------------------------------------
# Registro gratuito en https://developer.adzuna.com/signup
# Limites del plan gratuito: 25 peticiones/minuto y 250/dia.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Codigo de pais de Adzuna. "es" para Espana.
ADZUNA_COUNTRY=es

# --- Opcional: rutas y caché ---------------------------------------------
# Por defecto se usan las carpetas estandar del sistema operativo.
# CONVOCATORIAS_PROFILE_PATH=./profile.yaml
# CONVOCATORIAS_CACHE_PATH=./convocatorias-index.sqlite3

# Tiempo de vida de la cache, en segundos (por defecto 6 horas).
# Con 250 peticiones/dia, la cache no es una optimizacion: es un requisito.
# CONVOCATORIAS_CACHE_TTL=21600
